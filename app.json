{
  "expo": {
    "name": "AudioCoach AI",
    "slug": "auracheck-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "auracheck",
    "splash": {
      "backgroundColor": "#0b0c12",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.auracheck.ai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AudioCoach needs your microphone to analyze your voice.",
        "NSCameraUsageDescription": "AudioCoach needs your camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "AudioCoach needs photo access so you can choose a profile photo."
      }
    },
    "android": {
      "package": "com.audiocoach.ai",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0b0c12"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d264c07b-8d3a-4314-b980-919d54061744"
      }
    },
    "owner": "just-tapping"
  }
}
